# 微信小程序 AppID（必填）
WECHAT_APP_ID=

# 抓包获取的 access_token（必填，抢票前2小时内有效）
ACCESS_TOKEN=

# 小程序版本号
VER=4.40.1

# 省份ID / 城市ID
BS_CITY_ID=BL1034
LOCATION_CITY_ID=1101

# 票价（与所抢场次一致）
TICKET_PRICE=280.00
PRICE_DISPLAY=￥280

# 开抢时间（HH:MM:SS）
START_TIME=18:00:00

# 最大请求次数
MAX_REQUESTS=200

# 单个请求超时（秒）
REQUEST_TIMEOUT=3

# 重试间隔随机范围（秒）
RETRY_INTERVAL_MIN=0.15
RETRY_INTERVAL_MAX=0.4
