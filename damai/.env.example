# ============ 大麦模块配置模板 ============
# 复制为 damai/.env 后填写

# 演出详情页 URL（必填），如 https://m.damai.cn/damai/detail/item.html?itemId=xxxx
DAMAI_ITEM_URL=

# 开抢时间 HH:MM:SS（必填）
SALE_START_TIME=18:00:00

# 大麦 mtop 接口版本号（占位，待真机抓包确认后填写，见 docs/packet_capture.md）
# 抓包确认：下单接口名是 mtop.damai.trade.order.create.h5
DAMAI_ORDER_API=mtop.damai.trade.order.create.h5
DAMAI_API_VERSION=1.0

# 下单配置（均待真机抓包确认后填写）
# 票档 skuId，留空时 order.py 尝试开抢前从详情页运行时获取
SKU_ID=
# 观演人 ID，逗号分隔（如 123456,654321）；留空时尝试从页面上下文获取
BUYER_IDS=
# 下单数量，默认 1
QUANTITY=1

# 登录态文件路径（默认 damai/.auth/storage_state.json，一般无需修改）
# STORAGE_STATE_PATH=

# 抢票时是否无头模式（true/false，调试时建议 false 观察页面）
HEADLESS=false

# Server酱 SendKey（可选，微信推送抢票结果/滑块截图）
# 获取方式: https://sct.ftqq.com/ 微信扫码登录后查看
SERVERCHAN_SENDKEY=

# 登录等待超时（秒），默认 180
# LOGIN_TIMEOUT=180

# 滑块检测：选择器（逗号分隔）与人工处理轮询超时（秒）
# SLIDER_SELECTORS=iframe[id*=captcha],iframe[src*=punish],iframe[src*=ncaptcha],.captcha,.nc-container
# SLIDER_WAIT_TIMEOUT=120

# ---------- 预约抢票机制（开抢前预选票档/数量/观演人，开抢后直跳确认订单页）----------
# 开抢前 N 秒进入预取阶段：走预约入口直跳确认订单页，预取真实 skuId/buyerIds 缓存
# GET_SKU_BEFORE_START=5
# 页面加载超时（秒），独立于 REQUEST_TIMEOUT（避免 30 秒过长误事）
# PAGE_LOAD_TIMEOUT=30

# 预约入口/立即抢票按钮选择器（待真机抓包确认，见 docs/packet_capture.md 第 5.5 节）
# 开抢前主按钮文案「预约抢票」，开抢后变为「立即抢票」
# 默认空：必须抓包后填入，否则 reserve/grab 会提示手动点击
RESERVE_SUBMIT_SELECTOR=
BUY_NOW_SELECTOR=
# 确认订单页「提交订单」按钮选择器（order.create_order 点击它触发下单）
SUBMIT_ORDER_SELECTOR=.submit-btn,[class*=submit]
# 选票弹窗「确认」按钮选择器（详情页点主按钮后弹出选票弹窗，选完票价点确认进确认订单页）
SKU_CONFIRM_SELECTOR=
# 预约时票档/数量/观演人选择器（具体抓包后填，可留空表示用默认交互）
# RESERVE_SKU_SELECTOR=
# RESERVE_QTY_SELECTOR=
# RESERVE_BUYER_SELECTOR=

# 预约状态持久化路径（grab 预取阶段优先读本地缓存）
# RESERVE_STATE_PATH=damai/.auth/reserve_state.json

# 请求控制
# REQUEST_TIMEOUT=3
# RETRY_INTERVAL_MIN=0.15
# RETRY_INTERVAL_MAX=0.4
# MAX_ATTEMPTS=200
